{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Usage Widget",
  "version": "0.1.3",
  "identifier": "dev.codexusagewidget.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": { "icons/notification.png": "notification.png" },
    "shortDescription": "Read-only local Codex quota monitoring for Windows",
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": false },
      "minimumWebview2Version": "120.0.0.0",
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false, "languages": ["English"], "installerIcon": "icons/icon.ico", "uninstallerIcon": "icons/icon.ico", "installerHooks": "installer/hooks.nsh" }
    }
  }
}
